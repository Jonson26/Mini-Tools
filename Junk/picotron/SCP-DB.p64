--[[pod_format="raw",created="2025-12-12 12:59:43",modified="2025-12-19 13:52:27",revision=100,xstickers={}]]
include("data.lua")
include("util.lua")
include("script.lua")

function _init()
	poke(0x4000, get(fetch"/system/fonts/lil_mono.font"))
	scp_keys = {}
	for k, v in pairs(data) do
		scp_keys[#scp_keys+1] = k
	end
	scp_keys = sort_array(scp_keys)
	anim_delta = 0
	script_index = SCRIPT.INTRO
	selector = 0
end

function _update()
	anim_delta += 1
	if anim_delta>0 then
		script_update[script_index]()
	end
end

function _draw()
	script_draw[script_index]()
--	cls(0)
--	color(27)
--	cursor(240, 30)
--	print_in_box(animate_strings(scp_keys, 1, anim_delta))
--	cursor(10, 30)
--	print_in_box(animate_strings(welcome_message, 1, anim_delta))
--	print_in_box(animate_strings(data["SCP-682"].description, 1, anim_delta))
--	print_in_box(animate_strings(wrap_string(longstring, 44), 1, anim_delta))
--	print_in_box(wrap_string("ab c defg", 6))
--	print(tostring(str_anim_done), 450, 2, 8)
end
:: script.lua
--[[pod_format="raw",created="2025-12-18 15:24:16",modified="2025-12-19 14:35:08",revision=75,xstickers={}]]
SCRIPT = {
	INTRO=10,
	INTRO_WAIT=20,
	ARTICLE_SELECTION=30,
	DISPLAY_SUMMARY=40,
	DISPLAY_TEXT=50,
}

script_update = {
	[SCRIPT.INTRO] = function()
		if str_anim_done then
			anim_delta = 0
			script_index = SCRIPT.INTRO_WAIT
		end
	end,
	[SCRIPT.INTRO_WAIT] = function()
		if keyp() then
			anim_delta = -10
			script_index = SCRIPT.ARTICLE_SELECTION
		end
	end,
	[SCRIPT.ARTICLE_SELECTION] = function()
		if btnp(2) then
			selector-=1
		elseif btnp(3) then
			selector+=1
		elseif keyp("space") then
			article_id = scp_keys[selector+1]
			anim_delta = 0
			selector = 0
			script_index= SCRIPT.DISPLAY_SUMMARY
		end
		selector=selector%#scp_keys
	end,
	[SCRIPT.DISPLAY_SUMMARY] = function()
		if btnp(2) then
			selector-=1
		elseif btnp(3) then
			selector+=1
		elseif keyp("space") then
			cursor_y = 0
			anim_delta = -10
			if selector==0 then
				text = wrap_string(data[article_id].containment_procedures, 94)
				script_index = SCRIPT.DISPLAY_TEXT
			elseif selector==1 then
				text = wrap_string(data[article_id].description, 94)
				script_index = SCRIPT.DISPLAY_TEXT
			else
				selector = 0
				script_index = SCRIPT.ARTICLE_SELECTION
			end
		end
		selector=selector%3
	end,
	[SCRIPT.DISPLAY_TEXT] = function()
		if btnp(2) then
			cursor_y+=10
		elseif btnp(3) then
			cursor_y-=10
		elseif keyp("space") then
			anim_delta = 0
			selector = 0
			script_index= SCRIPT.DISPLAY_SUMMARY
		end
	end,
--	[100] = function()
--		print("2")
--	end,
}

script_draw = {
	[SCRIPT.INTRO] = function()
		cls(0)
		color(27)
		print_in_box(animate_strings(welcome_message, 1, anim_delta))
	end,
	[SCRIPT.INTRO_WAIT] = function()
		cls(0)
		color(27)
		if flr(anim_delta/30)%2==0 then
			welcome_message[12] = "        Press any key to continue."
		else
			welcome_message[12] = ""
		end
		print_in_box(welcome_message, 1, anim_delta)
	end,
	[SCRIPT.ARTICLE_SELECTION] = function()
		cls(0)
		color(27)
		selector_list = prep_selector_list(scp_keys, 1, selector+1)
		selector_list[1] = "Select Article"
		print_in_box(animate_strings(selector_list, 1, anim_delta))
	end,
	[SCRIPT.DISPLAY_SUMMARY] = function()
		cls(0)
		color(27)
		local summary = summarize_article(data[article_id], selector)
		print_in_box(animate_strings(summary, 1, anim_delta))
	end,
	[SCRIPT.DISPLAY_TEXT] = function()
		cls(0)
		color(27)
		cursor(0, cursor_y)
		print_in_box(animate_strings(text, 1, anim_delta))
	end,
}
:: util.lua
--[[pod_format="raw",created="2025-12-15 09:47:48",modified="2025-12-29 08:15:11",revision=96,xstickers={}]]


--Prints an array of strings in a box.
--(Works best with monospcaed font.)
function print_in_box(strs)
	--Find longest string in strs
	local l = 0
	for i=1, #strs do
		if l<#(strs[i]) then l=#(strs[i]) end
	end
	--Create line to put on the to & bottom of the box
	local s = "+"..right_pad("", l, "-").."+"
	print(s) --print top of box
	--Print every string (length adjusted) in strs with '|' at both ends
	for i=1, #strs do
		print("|"..right_pad(strs[i], l, " ").."|")
	end
	print(s) --print bottom of box
end

--Add c to the right of s, until s is at least l long
function right_pad(s, l, c)
	local out = s
	if #c<1 then return out end
	while #out<l do
		out ..= c
	end
	return out
end

--Add c to the left of s, until s is at least l long
function left_pad(s, l, c)
	local out = s
	if #c<1 then return out end
	while #out<l do
		out = c..out
	end
	return out
end

--Typewriter effect
function animate_strings(arr, delay, delta)
	local chars_target = flr(delta/delay)
	local out = {}
	local total_chars = 0
	local arr_i = 1
	while total_chars<chars_target and arr_i<=#arr do
		if #arr[arr_i]<(chars_target-total_chars) then
			out[arr_i]=arr[arr_i]
			total_chars+=#arr[arr_i]
			arr_i+=1
		else
			local s = ""
			for i=1,chars_target-total_chars do
				s..=arr[arr_i][i]
			end
			total_chars=chars_target
			out[arr_i]=s
		end
	end
	str_anim_done = false
	if (total_chars<chars_target) then; str_anim_done = true; end
	return out
end

--Text wrapping implementation
function wrap_string(str, width)
	local out = {}
	local out_index = 1
	local chr_index = 0
	while chr_index<#str do
		local i = 1
		local s = ""
		--Get as many characters from string as you can
		while i<=width and i<=(#str-chr_index) and str[chr_index+i]!='\n' do
			s..=str[chr_index+i]
			i+=1
		end
		local s_o = s
		local i_o = i
		--Try to not cut words into pieces
		while i>0 and not is_space(s[i]) do
			i-=1
			s=string.sub(s, 1, i)
		end
		--If "word" is longer than max width then we can cut it
		if i==0 then
			s = s_o
			i = i_o
		elseif i<i_o then
			i+=1
		end
		out[out_index] = s
		out_index+=1
		chr_index+=max(i-1, 1)
	end
	return out
end

--Tests if character is a space.
function is_space(char)
	if type(char)!="string" then
		return false
	end
	--return string.match(char, "[%p%s]")!=nil
	return string.match(char, "[%s]")!=nil
end

function prep_selector_list(strs, offset, index)
	out = {}
	for i=1, offset do
		out[i]=""
	end
	for i=1,#strs do
		if index == i then
			out[i+offset] = left_pad(strs[i], #strs[i]+1, ">")
		else
			out[i+offset] = left_pad(strs[i], #strs[i]+1, " ")
		end
		if data[strs[i]]!=nil then
			out[i+offset]..=" - "..data[strs[i]].title
		end
	end
	return out
end

function summarize_article(article, selecor)
	out = {
		"Item #: "..article.itemnum,
		"Object Class: "..article.objectclass,
		"",
		"Choose action:",
		"1) View special containment procedures",
		"2) View object description",
		"3) Go back",
	}
	if selector==0 then
		out[5]=">"..out[5]
		out[6]=" "..out[6]
		out[7]=" "..out[7]
	elseif selector==1 then
		out[5]=" "..out[5]
		out[6]=">"..out[6]
		out[7]=" "..out[7]
	else
		out[5]=" "..out[5]
		out[6]=" "..out[6]
		out[7]=">"..out[7]
	end
	return out
end

function sort_array(arr)
	local changed = true
	while changed do
		changed = false
		for i=1,#arr-1 do
			if arr[i]>arr[i+1] then
				changed = true
				local temp = arr[i]
				arr[i] = arr[i+1]
				arr[i+1] = temp
			end
		end
	end
	return arr
end
