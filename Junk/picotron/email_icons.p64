:: main.lua
--[[pod_format="raw",created="2025-08-29 10:31:44",modified="2025-11-21 11:34:05",revision=75,xstickers={}]]
include("data.lua")

function _init()
	window(150, 160, {title="Email Icons"})
	c = 7
	o = 0
	msg = ""
end

function _update()
	if btnp(4) then
		c = (c+1)%32
	elseif btnp(5) then
		o = (o+1)%2
	else
		mouse_x, mouse_y, mouse_b, wheel_x, wheel_y = mouse()
		s = 18-o*6
		if (mouse_x>0 and mouse_x<(s*8+2)) and 
		(mouse_y>0 and mouse_y<(s*8+2)) then
			x = flr(mouse_x/s)
			y = flr(mouse_y/s)
			i = x+y*8+o*64
			msg = ICON_DATA[i]
			if mouse_b>0 then
				set_clipboard(pod(get_spr(i)))
				notify("Copied icon "..msg)
			end
		end
	end
end

function _draw()
	cls(c)
	for i=0,64,1 do
		s = 18-o*6
		x = (i%8)*s+2
		y = flr(i/8)*s+2
		spr(i+o*64, x, y)
		if msg!=nil then
			print("\^i"..msg, 2, 150, 32)
			print(msg, 2, 150, 7)
		end
	end
end
