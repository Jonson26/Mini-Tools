:: main.lua
--[[pod_format="raw",created="2025-03-31 14:00:44",modified="2025-03-31 15:00:25",revision=172]]
function _init()
	--colors = {8, 24, 2, 7, 23, 14, 30, 16, 17, 12, 28, 29, 13, 18, 19, 3, 27, 11, 26, 10, 9, 25}
	colors = {8, 8, 8, 9, 9, 9, 10, 10, 10, 11, 11, 12, 12, 12, 30, 30, 30}	

	x = 0
	y = 0
	
	x_o = 240
	y_o = 135
	
	i = 0
end

function _update()
end

function _draw()
	cls(0)
	b = i/10*3.14159265359/180
	x_o = 240 + 60*cos(b)
	y_o = 135 + 30*sin(b)
	for j=1,3500,1 do
		r = j/10
		a = j*3.14159265359/180
		x=r*cos(a)
		y=r*sin(a)
		--pset(x+x_o, y+y_o, colors[i%count(colors)+1])
		circfill(x+x_o, y+y_o, min(r,sqrt(r)), colors[(j+i)%count(colors)+1])
	end
	i+=1
end
