:: pnglib.lua
--[[pod_format="raw",created="2025-12-01 12:30:04",modified="2025-12-01 15:40:15",revision=115,xstickers={}]]
--[[
PNG Parsing library
(c)2025 Filip Jamroga (aka Jonson26)
]]--

--8 by 8 bayer dither matrix
_DITHER_MATRIX_8 = {
	{ 0, 32,  8, 40,  2, 32, 10, 42},
	{48, 16, 56, 24, 50, 18, 58, 26},
	{12, 44,  4, 36, 14, 46,  6, 38},
	{60, 28, 52, 20, 62, 30, 54, 22},
	{ 3, 35, 11, 43,  1, 33,  9, 41},
	{51, 19, 59, 27, 49, 17, 57, 25},
	{15, 47,  7, 39, 13, 45,  5, 37},
	{63, 31, 55, 23, 61, 29, 53, 21}
}

--[[
Parses a PNG file
path    : String  -- path to the file
palette : Array   -- invert image colors
	{[col] = {r=red,g=green,b=blue}}
cutoff  : Number  -- At which colour in the palette to stop looking
dither  : Boolean -- set to true to dither the resulting image

returns a sprite as userdata
]]--
function parsePNG(path, palette, cutoff, dither)
	data = fetch(path, {raw_str=true})
	--data = userdata("u8", #data, 1, data)
	if type(data) == "userdata" then
		--print(tostr(data:attribs()))
		w = data:width()
		h = data:height()
		set_spr(0, data)
		spr(0,0,0)
		--print(w)
		--print(h)
		for y=0, w do
			l = ""
			for x=0, h do
				if data:get(x,y) != 0 then
					l ..= tostr(data:get(x,y))
				end
				--l = l..chr(data:get(x,y))
			end
			print(l)
		end
	else
		--print(data.."\n")
		for i=0, 60*270 do
			num=ord(sub(data, i))
			x = (i%60)*8
			y = flr(i/60)
			for j=0, 8 do
				if num%2>0 then
					pset(x+8-j, y, 7)
				end
				num = flr(num/2)
			end
		end
		for i=0, 240*270 do
			num=ord(sub(data, i))
			num_1=flr(num/16)
			num_2=num%16
			x = (i%240)*2
			y = flr(i/240)
			pset(x, y, num_1)
			pset(x+1, y, num_2)
		end
	end
end

function _headerData()
	out = {
		width = 0,
		height = 0,
		bit_depth = 0,
		color_type = 0,
		compression_method = 0,
		filter_method = 0,
		interlace_method = 0
	}
	return out
end

function _nextChunk()
end

function _handleChunk()
end

--[[
Returns the current palette as an array
	{[col] = {r=red,g=green,b=blue}}
]]--
function getPal()
	out = {}
	for c = 0, 63, 1 do
		s = peek4(0x5000 + 4 * c)
		s = string.format("%x", s)
		while #s<6 do
			s = "0"..s
		end
		red   = tonumber(s:sub(1,2),16)
		green = tonumber(s:sub(3,4),16)
		blue  = tonumber(s:sub(5,6),16)
		out[c] = {
			r = red,
			g = green,
			b = blue
		}
	end
	return out
end

function _closestColor(rgb, palette, cutoff)
	dist_min = 255*255*255
	c_min = 0
	r = rgb.r
	g = rgb.g
	b = rgb.b
	for c,col in pairs(palette) do
		if c==cutoff then
			break
		end
		dist = (r - col.r)^2+(g - col.g)^2+(b - col.b)^2
		if dist<dist_min then
			dist_min = dist
			c_min = c
		end
	end
	return c_min
end

--Bayer dithering
function _dither(rgb, x, y)
	v = _DITHER_MATRIX_8[x%8+1][y%8+1]
	rgb.r += v
	rgb.g += v
	rgb.b += v
	return rgb
end
