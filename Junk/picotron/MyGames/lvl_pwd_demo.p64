--[[pod_format="raw",created="2025-09-30 13:03:00",modified="2025-09-30 13:48:23",revision=15,xstickers={}]]
function _init()
	num_cells = 4
	current_cell = 1
	cells = {}
	for i=1,num_cells,1 do
		cells[i] = "A"
	end
end

function _update()
	if btnp(0) then
		current_cell -= 1
	elseif btnp(1) then
		current_cell += 1
	elseif btnp(2) then
		cells[current_cell] = rotate(cells[current_cell], -1)
	elseif btnp(3) then
		cells[current_cell] = rotate(cells[current_cell], 1)
	end
	if current_cell<1  then
		current_cell = 1
	elseif current_cell>num_cells then
		current_cell = num_cells
	end
end

function _draw()
	cls(0)
	code = ""
	indicator = ""
	for i=1,num_cells,1 do
		code ..= cells[i]
	end
	for i=1,current_cell-1,1 do
		indicator ..= " "
	end
	--print(indicator.."V")
	print(code, 20, 20)
	print(indicator.."^")
end

function rotate(c, i)
	o = ord(c)-65
	o += i
	o = o%26
	o += 65
	return chr(o)
end
