:: door.lua
--[[pod_format="raw",created="2024-04-05 19:38:20",modified="2024-09-25 19:32:19",revision=852]]
function create_door(id, hall_id, pos)
	local door = {}
	door.id = id
	door.hall_id = hall_id
	door.pos = pos
	door.open = false
	
	function door:draw()
		local tile = create_tile(self.pos.x, self.pos.y, 7, tile_type_enum.door, false)
		tile.door_id = self.id
		if self.open then
			tile.sprite = 6
			tile.walkable = true
		end
		state.output_tiles[self.pos.y][self.pos.x] = tile
	end
	
	return door
end

function gen_doors()
	for i, v in pairs(state.halls) do
		add(state.doors, create_door(#state.doors + 1, i, v.points[0]))
		add(state.doors, create_door(#state.doors + 1, i, v.points[#v.points]))
	end
end
:: enemy.lua
--[[pod_format="raw",created="2024-04-06 15:47:02",modified="2025-11-25 12:48:55",revision=3039,xstickers={}]]
function create_enemy(id, pos, name, sprite, hp, dmg, xp)
	local enemy = {}
	enemy.id = id
	enemy.pos = pos
	enemy.name = name
	enemy.sprite = sprite
	enemy.hp = hp
	enemy.dmg = dmg
	enemy.xp = xp
	enemy.alive = true
	if rnd(state.floor / 2) > .2 then
		enemy.state = enemy_state_enum.roaming
	else
		enemy.state = enemy_state_enum.asleep
	end
	
	function enemy:update()
		if self.state == enemy_state_enum.hostile then
			if state.player.pos:distance_to(self.pos):magn() > 1 then
				self:move()
			elseif state.player.pos:distance_to(self.pos):magn() > 15 then
				self.state = enemy_state_enum.roaming
			else
				self:attack()
			end
		elseif self.state == enemy_state_enum.roaming then
			if state.player:can_see(self.pos) and 
				state.player.pos:distance_to(self.pos):magn() < 15 then
				self.state = enemy_state_enum.hostile
				if state.player.pos:distance_to(self.pos):magn() > 1 then
					self:move()
				elseif state.player.pos:distance_to(self.pos):magn() > 15 then
					self.state = enemy_state_enum.roaming
				else
					self:attack()
				end
			else
				self:roam()
			end
		end
	end
	
	function enemy:draw()
		if self.alive then
			local tile = create_tile(
				self.pos.x, 
				self.pos.y, 
				self.sprite, 
				tile_type_enum.enemy, 
				true)
			if self.state == enemy_state_enum.asleep then
				tile.sprite = tile.sprite + 18
			end
			tile.enemy_id = self.id
			tile.seen = state.output_tiles[self.pos.y][self.pos.x].seen
			state.output_tiles[self.pos.y][self.pos.x] = tile
		end
	end
	
	function enemy:move()
		local close_pos = self.pos
		local target = state.player.pos
		local min_dist = close_pos:distance_to(target):magn()
		for i=-1, 1 do
			local tile1 = state.output_tiles[self.pos.y][self.pos.x + i]
			local tile2 = state.output_tiles[self.pos.y + i][self.pos.x]
			local dist1_mag = tile1.pos:distance_to(target):magn()
			local dist2_mag = tile2.pos:distance_to(target):magn()
			local enemy_in_pos1 = nil
			local enemy_in_pos2 = nil
			for _, v in pairs(state.enemies) do
				if v.pos.x == tile1.pos.x and v.pos.y == tile1.pos.y and v.id ~= self.id then
					enemy_in_pos1 = true
					break
				end
				if v.pos.x == tile2.pos.x and v.pos.y == tile2.pos.y and v.id ~= self.id then
					enemy_in_pos2 = true
					break
				end
			end
			if dist1_mag < min_dist and tile1.walkable and not enemy_in_pos1 then
				close_pos = tile1.pos
				min_dist = dist1_mag
			end
			if dist2_mag < min_dist and tile2.walkable and not enemy_in_pos2 then
				close_pos = tile2.pos
				min_dist = dist2_mag
			end
		end
		self.pos = close_pos
	end
	
	function enemy:roam()
		local tiles = {}
		for i in all({-1, 1}) do
			local tile1 = state.output_tiles[self.pos.y][self.pos.x + i]
			local tile2 = state.output_tiles[self.pos.y + i][self.pos.x]
			local enemy_in_pos1 = nil
			local enemy_in_pos2 = nil
			for _, v in pairs(state.enemies) do
				if v.pos.x == tile1.pos.x and v.pos.y == tile1.pos.y and v.id ~= self.id then
					enemy_in_pos1 = true
					break
				end
				if v.pos.x == tile2.pos.x and v.pos.y == tile2.pos.y and v.id ~= self.id then
					enemy_in_pos2 = true
					break
				end
			end
			if (tile1.walkable or tile1.door_id) and 
				not enemy_in_pos1 then
				add(tiles, tile1)
			end
			if (tile2.walkable or tile2.door_id) and 
				not enemy_in_pos2 then
				add(tiles, tile2)
			end
		end
		local tile = tiles[rnd_int(1, #tiles + 1)]
		if tile.door_id and not state.doors[tile.door_id].open then
			state.doors[tile.door_id].open = true
		else
			self.pos = tile.pos
		end
	end
	
	function enemy:attack()
		local dmg = self.dmg
		if state.player.armor then
			--dmg -= state.player.armor.func
			if sub(state.player.armor.name, -1) == "*" then
				dmg /= 2
			end
			if rnd_int(1,11)<state.player.armor.func then
				dmg /= 2
			end
			dmg = ceil(dmg)
		end
		if dmg<0 then dmg=0 end
		state.player.hp -= dmg
		add(state.logline, "Attacked Player for " .. dmg)
		if state.player.hp <= 0 then
			state.mode = mode_enum.game_end
		end
	end
	
	return enemy
end

function create_goblin(id, pos)
	local gob = create_enemy(id, pos, "Goblin", 3, 14, 6, 12)
	return gob
end

function create_orc(id, pos)
	local orc = create_enemy(id, pos, "Orc", 11, 20, 8, 23)
	return orc
end

function create_kobold(id, pos)
	local kob = create_enemy(id, pos, "Kobold", 24, 10, 4, 8)
	return kob
end

function create_lich(id, pos)
	local lich = create_enemy(id, pos, "Lich", 25, 80, 12, 800)
	lich.state = enemy_state_enum.roaming
	return lich
end

function gen_enemies()
	state.enemies = {}
	if state.floor == 10 then
		add(state.enemies, create_lich(1, get_enemy_spawn()))
		state.enemies[1]:draw()
		return
	end
	local enemy_num = rnd_int(6, 7 + state.floor)
	for i=1, enemy_num do
		local enemy
		local choice = rnd(1)
		if choice > state.floor / 10 then
			enemy = create_kobold
		elseif choice > state.floor / 20 then
			enemy = create_goblin
		else
			enemy = create_orc
		end
		add(state.enemies, enemy(i, get_enemy_spawn()))
		state.enemies[i]:draw()
	end
end

function get_enemy_spawn()
	local spawn_x, spawn_y, tile
	repeat
		local room_ind = flr(rnd(#state.rooms))
		local room = state.rooms[room_ind]
		spawn_x = rnd_int(room.top_left.x + 1, room.bot_right.x - 1)
		spawn_y = rnd_int(room.top_left.y + 1, room.bot_right.y - 1)
		tile = state.output_tiles[spawn_y][spawn_x]
	until tile.walkable and
		(math.abs(spawn_x - state.player.pos.x) +
		math.abs(spawn_y - state.player.pos.y) > 1)
	return create_pos(spawn_x, spawn_y)
end

enemy_state_enum = {
	hostile = 1,
	asleep = 2,
	roaming = 3
}
:: equipment.lua
--[[pod_format="raw",created="2024-04-13 13:47:01",modified="2025-01-27 15:51:35",revision=377]]
equip_type_enum = {
	Copper = {"Copper", 1},
	Bronze = {"Bronze", 2},
	Iron = {"Iron", 3},
	Steel = {"Steel", 4},
	Adamantite = {"Adamantite", 5}
}

function create_equipment(index, item_type)
	local quality = equip_type_enum.Copper
	local choice = rnd(5)
	
	if state.floor < 3 then
		if choice > 4 then
			quality = equip_type_enum.Iron
		elseif choice > 3 then
			quality = equip_type_enum.Bronze
		end
	elseif state.floor > 8 then
		if choice > 4 then
			quality = equip_type_enum.Iron
		elseif choice > 3 then
			quality = equip_type_enum.Steel
		else
			quality = equip_type_enum.Adamantite
		end
	else
		if choice > 3.4 then
			quality = equip_type_enum.Steel
		elseif choice > 1.7 then
			quality = equip_type_enum.Iron
		else
			quality = equip_type_enum.Bronze
		end
	end
	
	local name = " Shield"
	local sprite = 9
	if item_type == item_type_enum.sword then
		name = " Sword"
		sprite = 12
	end
	
	return create_item(
				index, 
				get_item_spawn(), 
				item_type, 
				quality[2], 
				quality[1] .. name,
				sprite)
end
			
:: hall.lua
--[[pod_format="raw",created="2024-04-05 17:57:18",modified="2025-11-26 10:35:14",revision=1873,xstickers={}]]
function create_hall(room1_id, room2_id, dir)
	local room1 = state.rooms[room1_id]
	local room2 = state.rooms[room2_id]
	
	local room1_center = create_pos((room1.top_left.x + room1.bot_right.x) / 2, 
		(room1.top_left.y + room1.bot_right.y) / 2)
	local room2_center = create_pos((room2.top_left.x + room2.bot_right.x) / 2, 
		(room2.top_left.y + room2.bot_right.y) / 2)
		
	local dist_vector = room1_center:vector_to(room2_center)
	
	local hall = {}
	hall.room1_id = room1_id
	hall.room2_id = room2_id
	hall.points = {}
	
	local start_point
	local second_point
	local end_point
	local penult_point
	
	if dir.x == -1 then
		start_point = create_pos(room1.top_left.x - 1, rnd_int(room1.top_left.y + 1, room1.bot_right.y - 1))
		second_point = create_pos(start_point.x - 1, start_point.y)
		
		end_point = create_pos(room2.bot_right.x + 1, rnd_int(room2.top_left.y + 1, room2.bot_right.y - 1))
		penult_point = create_pos(end_point.x + 1, end_point.y)
	elseif dir.x == 1 then
		start_point = create_pos(room1.bot_right.x + 1, rnd_int(room1.top_left.y + 1, room1.bot_right.y - 1))
		second_point = create_pos(start_point.x + 1, start_point.y)
		
		end_point = create_pos(room2.top_left.x - 1, rnd_int(room2.top_left.y + 1, room2.bot_right.y - 1))
		penult_point = create_pos(end_point.x - 1, end_point.y)
	elseif dir.y == 1 then
		start_point = create_pos(rnd_int(room1.top_left.x + 1, room1.bot_right.x - 1), room1.bot_right.y + 1)
		second_point = create_pos(start_point.x, start_point.y + 1)
		
		end_point = create_pos(rnd_int(room2.top_left.x + 1, room2.bot_right.x - 1), room2.top_left.y - 1)
		penult_point = create_pos(end_point.x, end_point.y - 1)
	elseif dir.y == -1 then
		start_point = create_pos(rnd_int(room1.top_left.x + 1, room1.bot_right.x - 1), room1.top_left.y - 1)
		second_point = create_pos(start_point.x, start_point.y - 1)
		
		end_point = create_pos(rnd_int(room2.top_left.x + 1, room2.bot_right.x - 1), room2.bot_right.y + 1)
		penult_point = create_pos(end_point.x, end_point.y + 1)
	end
	
	hall.points[0] = start_point
	hall.points[1] = second_point
	
	local vec_left = second_point:vector_to(penult_point)
	local dist_left = second_point:distance_to(penult_point)
	local x_dir = -1 * vec_left.x / dist_left.x
	local y_dir = -1 * vec_left.y / dist_left.y
	
	while dist_left.x + dist_left.y > 1 do
		local last_pnt = hall.points[#hall.points]
		if (flr(rnd(1)) > 0 or dist_left.y == 0) and dist_left.x > 0 then
			add(hall.points, create_pos(last_pnt.x + x_dir, last_pnt.y))
			dist_left.x -= 1
		else
			add(hall.points, create_pos(last_pnt.x, last_pnt.y + y_dir))
			dist_left.y -= 1
		end
	end
	
	add(hall.points, penult_point)
	add(hall.points, end_point)
	
	function hall:is_inside(pos)
		for v in all(self.points) do
			if v.x == pos.x and v.y == pos.y then
				return true
			end
		end
		return false
	end
	
	function hall:draw()
		for i, v in pairs(hall.points) do
			local tile = create_tile(v.x, v.y, 255, tile_type_enum.floor, true)
			local visible = v:distance_to(state.player.pos):magn() <= 2 and 
				hall:is_inside(state.player.pos)
			tile.hall_id = i
			if visible then
				tile.sprite = 1
				tile.seen = true
				state.tiles[v.y][v.x].seen = true
			end
			state.output_tiles[v.y][v.x] = tile
		end
	end
	return hall
end

function gen_halls()
	for i=1, #state.rooms do
		local dir 
		if i == 1 or i == 2 or i == 8 then
			dir = create_pos(0, -1)
		elseif i == 3 or i == 4 then
			dir = create_pos(-1, 0)
		elseif i == 5 or i == 6 then
			dir = create_pos(0, 1)
		elseif i == 7 then
			dir = create_pos(1, 0)
		end
		
		add(state.halls, create_hall(i, i - 1, dir))
	end
		
	add(state.halls, create_hall(8, 3, create_pos(0, 1)))
	add(state.halls, create_hall(8, 1, create_pos(-1, 0)))
	add(state.halls, create_hall(8, 5, create_pos(1, 0)))
	add(state.halls, create_hall(7, 0, create_pos(-1, 0)))
end
			
:: input.lua
--[[pod_format="raw",created="2024-04-03 18:11:06",modified="2025-01-27 15:51:09",revision=4669]]
repeat_flag = 0
repeat_input_flag = nil
function game_input()
	if btnp(4) then state.player:move(0, 0)
	elseif btnp(0) and not btn(4) then state.player:move(-1, 0)
	elseif btnp(1) and not btn(4) then state.player:move(1, 0)
	elseif btnp(2) and not btn(4) then state.player:move(0, -1)
	elseif btnp(3) and not btn(4) then state.player:move(0, 1)
	elseif btn(4) then
		if btn(5) then
			if repeat_flag > 2 then
				state.player:move(0, 0)
			end
		elseif (btnp(0) or repeat_input_flag == 0) then
				state.player:move(-1, 0)
				repeat_input_flag = 0
				if state.player:check_surroundings(create_pos(-1, 0)) then
					repeat_input_flag = nil
				end
		elseif (btnp(1) or repeat_input_flag == 1) then
				state.player:move(1, 0)
				repeat_input_flag = 1
				if state.player:check_surroundings(create_pos(1, 0)) then
					repeat_input_flag = nil
				end
		elseif (btnp(2) or repeat_input_flag == 2) then
				state.player:move(0, -1)
				repeat_input_flag = 2
				if state.player:check_surroundings(create_pos(0, -1)) then
					repeat_input_flag = nil
				end
		elseif (btnp(3) or repeat_input_flag == 3) then
				state.player:move(0, 1)
				repeat_input_flag = 3
				if state.player:check_surroundings(create_pos(0, 1)) then
					repeat_input_flag = nil
				end
		else 
			repeat_input_flag = nil
		end	
	elseif btnp(5) then 
		sfx(4)
		state.mode = mode_enum.inv 
	 	state.draw = true
	end
	
	repeat_flag += 1
	if repeat_flag == 4 then
		repeat_flag = 0
	end
end

function inv_input()
	if state.menu_index then
		if btnp(2) and state.menu_index > 1 then
			sfx(3)
			state.menu_index -= 1
			state.updated = true
		elseif btnp(3) and state.menu_index < 2 then 
			sfx(3)
			state.menu_index += 1
			state.updated = true
		elseif btnp(4) then 
			if state.menu_index == 1 then
				state.player:use_item(state.inv_index)
			else
				state.player:drop_item(state.inv_index)
			end
			state.menu_index = nil
		 	state.updated = true
		elseif btnp(5) then 
			sfx(5)
			state.menu_index = nil
			state.updated = true
		end
		return
	end
	if btnp(2) and state.inv_index > 1 then
		sfx(3)
		state.inv_index -= 1
		state.updated = true
	elseif btnp(3) and state.inv_index < #state.player.inv then 
		sfx(3)
		state.inv_index += 1
		state.updated = true
	elseif btnp(4) then 
		if #state.player.inv == 0 then
			sfx(6)
			return
		end
		sfx(4)
		state.menu_index = 1
	 	state.updated = true
	elseif btnp(5) then 
		sfx(5)
		state.mode = mode_enum.game
		state.updated = true
	end
end

function stair_input()
	if btnp(2) and state.stair_index > 1 then
		sfx(3)
		state.stair_index -= 1
		state.updated = true
	elseif btnp(3) and state.stair_index < 2 then 
		sfx(3)
		state.stair_index += 1
		state.updated = true
	elseif btnp(4) then 
		if state.stair_index == 1 then
			sfx(4)
			next_floor()
		elseif state.stair_index == 2 then
			sfx(5)
		end
		state.mode = mode_enum.game
	 	state.updated = true
	elseif btnp(5) then 
		sfx(5)
		state.mode = mode_enum.game
		state.updated = true
	end
end

function dir_input()
	if btnp(0) then
		sfx(4)
		state.dir = create_pos(-1, 0)
		state.mode = mode_enum.game
		state.updated = true
	elseif btnp(1) then 
		sfx(4)
		state.dir = create_pos(1, 0)
		state.mode = mode_enum.game
		state.updated = true
	elseif btnp(2) then
		sfx(4)
		state.dir = create_pos(0, -1)
		state.mode = mode_enum.game
		state.updated = true
	elseif btnp(3) then 
		sfx(4)
		state.dir = create_pos(0, 1)
		state.mode = mode_enum.game
		state.updated = true
	elseif btnp(4) then 
		sfx(6)
	elseif btnp(5) then 
		sfx(5)
		state.mode = mode_enum.game
		state.updated = true
	end
end
:: item.lua
--[[pod_format="raw",created="2024-04-06 19:33:19",modified="2025-11-25 12:37:17",revision=2698,xstickers={}]]
function create_item(id, pos, type, func, name, sprite)
	local item = {}
	item.id = id
	item.pos = pos
	item.type = type
	item.func = func
	item.sprite = sprite
	item.name = name
	item.equipped = false
	
	function item:draw()
		local tile = create_tile(
			self.pos.x, 
			self.pos.y, 
			self.sprite, 
			tile_type_enum.item, 
			true)
		tile.item_id = self.id
		if not state.output_tiles[self.pos.y][self.pos.x].enemy_id then
			tile.seen = state.output_tiles[self.pos.y][self.pos.x].seen
			state.output_tiles[self.pos.y][self.pos.x] = tile
		end
	end
	
	return item
end

item_type_enum = {
	potion = 1,
	gold = 2,
	bread = 3,
	armor = 4,
	sword = 5,
	scroll = 6
}

function item_funcs(entity)
	function entity:heal_potion()
		local heal_val = rnd_int(4, 10)
		self.hp += heal_val
		if self.hp >= self.max_hp then
			self.hp = self.max_hp
			add(state.logline, "Healed " .. self.name .. " to full!")
			return
		end
		add(state.logline, "Healed " .. self.name .. " for " .. heal_val)
	end
	
	function entity:life_potion()
		self.max_hp += 5
		self.hp += 5
		add(state.logline, "Health Increased")
	end
	
	function entity:full_potion()
		self.full_belly_timer = 50
		self.belly = 100
		add(state.logline, "Belly filled for a while")
	end
	
	function entity:enchant_sword()
		if not self.sword then
			add(state.logline, "No Sword Equipped!")
			return
		end
		if sub(self.sword.name, -1) == "*" then
			add(state.logline, "Sword Already Enchanted!")
			return
		end
		self.sword.func += 2
		self.sword.name = self.sword.name .. " *"
		add(state.logline, "Sword Enchanted")
	end
	
	function entity:enchant_shield()
		if not self.armor then
			add(state.logline, "No Shield Equipped!")
			return
		end
		if sub(self.armor.name, -1) == "*" then
			add(state.logline, "Shield Already Enchanted!")
			return
		end
		self.armor.func += 2
		self.armor.name = self.armor.name .. " *"
		add(state.logline, "Shield Enchanted")
	end
	
	function entity:sleep_scroll()
		for i, _ in pairs(state.enemies) do
			state.enemies[i].state = enemy_state_enum.asleep
		end
		
		add(state.logline, "Put all enemies to sleep!")
	end
	
	function entity:eat_bread()
		self.belly += 50
		if self.belly > 100 then
			self.belly = 100
		end
		add(state.logline, "Ate Bread")
	end
end

function gen_items()
	state.items = {}
	local num_of_items = rnd_int(8, 12)
	for i=1, num_of_items do
		local choice = rnd(1)
		if choice > .97 then
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.potion, 
				state.player.heal_potion, 
				"Heal Potion",
				4))
		elseif choice > .95 then
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.potion, 
				state.player.full_potion, 
				"Full Belly Potion",
				17))
		elseif choice > .92 then
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.potion, 
				state.player.life_potion, 
				"Life Potion",
				19))
		elseif choice > .9 then
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.potion, 
				state.player.level_up, 
				"Level Up Potion",
				18))
		elseif choice > .85 then
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.potion, 
				state.player.enchant_shield, 
				"Enchant Shield Scroll",
				15))
		elseif choice > .8 then
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.potion, 
				state.player.enchant_sword, 
				"Enchant Sword Scroll",
				14))
		elseif choice > .77 then
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.potion, 
				state.player.sleep_scroll, 
				"Sleep Scroll",
				20))
		elseif choice > .72 then
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.scroll, 
				3, 
				"Lightning Scroll",
				13))
		elseif choice > .58 then
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.bread, 
				state.player.eat_bread, 
				"Bread",
				10))
		elseif choice > .5 then
			local val = 2
			add(state.items, 
				create_equipment(i, item_type_enum.sword))
		elseif choice > .4 then
			local val = 1
			add(state.items, 
				create_equipment(i, item_type_enum.armor))
		else
			local val = rnd_int(10, 25)
			add(state.items, 
				create_item(
				i, 
				get_item_spawn(), 
				item_type_enum.gold, 
				val, 
				val .. " Gold",
				5))
		end
		state.items[i]:draw()
	end
end
		
function get_item_spawn()
	local room_ind = flr(rnd(#state.rooms))
	local room = state.rooms[room_ind]
	local spawn_x, spawn_y, tile
	repeat
		spawn_x = rnd_int(room.top_left.x + 1, room.bot_right.x - 1)
		spawn_y = rnd_int(room.top_left.y + 1, room.bot_right.y - 1)
		tile = state.output_tiles[spawn_y][spawn_x]
	until tile.walkable and not tile.item_id and not tile.enemy_id
	return create_pos(spawn_x, spawn_y)
end
	
:: main.lua
--[[pod_format="raw",created="2024-04-03 17:12:03",modified="2025-11-26 10:58:47",revision=5374,xstickers={}]]
include("state.lua")
include("tiles.lua")
include("player.lua")
include("input.lua")
include("pos.lua")
include("room.lua")
include("util.lua")
include("hall.lua")
include("door.lua")
include("enemy.lua")
include("item.lua")
include("stair.lua")
include("projectile.lua")
include("equipment.lua")
include("minimap.lua")

function _init()
	spr_offset = 256
	music(5)
	blink_flag = false
	blink_timer = 0
	vid(1)
	
	state = {}
	state.dir = nil
	state.floor = 1
	state.updated = false
	state.draw = true
	state.turn_counter = 0
	state.mode = mode_enum.game_start
	state.tiles = gen_tiles()
	state.output_tiles = {}
	state.logline = {"Welcome to Pogue!"}
	state.sections = get_sections()
	state.stair_index = 1
	state.inv_index = 1
	state.menu_index = nil
	state.rooms = {}
	for i, v in pairs(state.sections) do
		state.rooms[i] = create_room(i)
	end
	state.halls = {}
	gen_halls()
	state.doors = {}
	gen_doors()
	state.player = create_player()
	
	reset_output()
	for _, v in pairs(state.rooms) do
		v:draw()
	end
	for _, v in pairs(state.halls) do
		v:draw()
	end
	for _, v in pairs(state.doors) do
		if state.player:can_see(v.pos) then
			v:draw()
		end
	end
	gen_enemies()
	state.player:draw()
	for _, v in pairs(state.enemies) do
		if state.player:can_see(v.pos) then
			v:draw()
		end
	end
	gen_items()
	for _, v in pairs(state.items) do
		if state.player:can_see(v.pos) then
			v:draw()
		end
	end
	state.stair = create_stair()
	state.stair:draw()
	
	gen_map(state.output_tiles)
end

function _update()
	if state.mode == mode_enum.game_start then
		if btnp(5) then 
			sfx(7)
			music(4)
			state.mode = mode_enum.game
			state.updated = true
		end
	elseif state.mode == mode_enum.game then
		game_update()
	elseif state.mode == mode_enum.inv then
		inv_update()
	elseif state.mode == mode_enum.stair then
		stair_update()
	elseif state.mode == mode_enum.dir then
		dir_update()
	elseif state.mode == mode_enum.game_end then	
		if btnp(5) then
			sfx(7)
			music(4)
			state.logline = {"Welcome to Pogue!"}
			state.player = create_player()
			state.floor = 0
			next_floor()
			state.mode = mode_enum.game
			state.updated = true
		end
	end
end

function _draw()
	if state.mode == mode_enum.game_start or state.mode == mode_enum.game_end then
		if blink_timer % 30 == 0 then 
			blink_flag = not blink_flag 
			state.draw = true
		end			
	elseif state.mode == mode_enum.game and blink_timer % 20 == 0 then
		local pos = state.player.pos
		local sprite = 0
		if state.output_tiles[pos.y][pos.x].sprite == sprite then
			sprite = 16
		end
		state.draw = true
		state.output_tiles[pos.y][pos.x].sprite = sprite
	end
	blink_timer += 1
	if state.updated or state.draw then
		cls()
		if state.mode == mode_enum.game_start then
			print("Welcome to Pogue!", 200, 75)
			if blink_flag then print("Press \"x\" to begin!", 197, 90) end
		elseif state.mode == mode_enum.game then
			spr(spr_offset+56,0 ,0)
			gen_map(state.output_tiles)
			print(state.logline[#state.logline - 2])
			print(state.logline[#state.logline - 1])
			color(7)
			print(state.logline[#state.logline])
			color(6)
			print("\n" .. "HP: " .. state.player.hp .. "/" .. state.player.max_hp)
			print("Belly: " .. state.player.belly)
			local atk_val = state.player.dmg
			if state.player.sword then 
				atk_val += state.player.sword.func
			end
			print("Attack: " .. atk_val)
			local def_val = 0
			if state.player.armor then 
				def_val = state.player.armor.func
			end
			print("Defense: " .. def_val)
			print("\nFloor: " .. state.floor)
			print("Level: " .. state.player.level)
			print("Gold: " .. state.player.gold)
			map(state.player.pos.x - 7 + 15, state.player.pos.y - 7 + 15, 150, 50, 15, 15)
			draw_minimap()
		elseif state.mode == mode_enum.inv then
			print("Inventory:", 10, 10)
			if #state.player.inv == 0 then
				print ("(empty)", 10, 30)
			end
			for i, v in pairs(state.player.inv) do
				if i == state.inv_index then
					color(10)
				else
					color(6)
				end
				local name = i .. ") " .. v.name
				if v.equipped then
					name = name .. " (E)"
				end
				print(name, 20, 20 + (i * 10))
				color(6)
			end		
			if state.menu_index then
				print("Do what?:", 290, 10)
				for i, v in pairs({"Use", "Drop"}) do
					if i == state.menu_index then
						color(10)
					else
						color(6)
					end
					print(i .. ") " .. v, 290, 20 + (i * 10))
					color(6)
				end
			end
		elseif state.mode == mode_enum.stair then
			print("Proceed to next floor?:", 10, 10)
			for i, v in pairs({"Yes", "No"}) do
				if i == state.stair_index then
					color(10)
				else
					color(6)
				end
				print(i .. ") " .. v, 20, 20 + (i * 10))
				color(6)
			end
		elseif state.mode == mode_enum.dir then
			print("Which direction?", 10, 10)
		elseif state.mode == mode_enum.game_end then
			music(-1) 
			if state.player.hp > 0 then
				if state.updated then sfx(11, 1) end
				print("You Win!", 225, 75)
				print("You collected " .. state.player.gold .. " gold!", 197, 105)
			else 
				if state.updated then sfx(10, 1) end
				print("You Died", 224, 75) 
				if state.player.belly <= 0 then
					print("You starved to death!", 197, 105)
				else
					print("You were killed!", 210, 105)
				end
				print("You collected " .. state.player.gold .. " gold!", 197, 120)
			end
			if blink_flag then print("Press \"x\" to play again!", 190, 90) end
		end
		state.updated = false
		state.draw = false
	end
end

function game_update()
	if state.dir then
		local result = fire_projectile(state.player.pos, state.dir)
		if result then
			state.player:attack(result)
		else
			sfx(13)
			add(state.logline, "Missed!")
		end
		state.dir = nil
		return
	end
	game_input()
	if state.updated then
		reset_output()
		for _, v in pairs(state.rooms) do
			v:draw()
		end
		for _, v in pairs(state.halls) do
			v:draw()
		end
		for _, v in pairs(state.doors) do
			if state.player:can_see(v.pos) then
				v:draw()
			end
		end
		state.player:draw()
		for _, v in pairs(state.enemies) do
			if v.alive then
				v:update()
				if state.player:can_see(v.pos) then
					v:draw()
				end
			end
		end
		
		for _, v in pairs(state.items) do
			if state.player:can_see(v.pos) then
				v:draw()
			end
		end
		if state.stair != nil then
			state.stair:draw()
		end
		state.turn_counter += 1
	end
end

function inv_update()
	inv_input()
end

function stair_update()
	stair_input()
end

function dir_update()
	dir_input()
end
:: minimap.lua
--[[pod_format="raw",created="2024-04-13 16:36:20",modified="2025-03-12 14:23:45",revision=315]]
function draw_minimap()
	local start_x = 300
	local start_y = 50
	for i=0, #state.output_tiles do
		for j=0, #state.output_tiles[i] do
			local tile = state.tiles[i][j]
			local out_tile = state.output_tiles[i][j]
			local sprite = 64
			if tile.seen then
				if out_tile.type == tile_type_enum.player then
					sprite = 72
				elseif out_tile.type == tile_type_enum.enemy then
					sprite = 66
				elseif out_tile.type == tile_type_enum.item then
					sprite = 65
				elseif state.stair and i == state.stair.pos.y and j == state.stair.pos.x then
					sprite = 67
				end
				spr(sprite, start_x + (j * 4), start_y + (i * 4))
			end
		end
	end
end
:: player.lua
--[[pod_format="raw",created="2024-04-03 17:59:58",modified="2025-01-27 15:51:00",revision=5033]]
function create_player()
	local player = {}
	player.pos = get_player_spawn()
	player.dmg = 4
	player.hp = 30
	player.xp = 0
	player.level = 1
	player.next_xp = 80
	player.max_hp = player.hp
	player.inv = {}
	player.name = "Player"
	player.gold = 0
	player.belly = 100
	player.armor = nil
	player.sword = nil
	player.full_belly_timer = 0
	
	function player:draw()
		local tile = create_tile(
			self.pos.x, 
			self.pos.y, 
			0, 
			tile_type_enum.player, 
			false)
		tile.seen = state.tiles[self.pos.y][self.pos.x].seen
		state.output_tiles[self.pos.y][self.pos.x] = tile
	end
	
	function player:move(d_x, d_y)
		local new_x = self.pos.x + d_x
		local new_y = self.pos.y + d_y
		local tile = state.output_tiles[new_y][new_x]
		state.updated = true
		if tile.enemy_id then
			self:attack(tile.enemy_id)
			sfx(1)
		elseif tile.door_id and not state.doors[tile.door_id].open then
			state.doors[tile.door_id].open = true
			add(state.logline, "Door Opened")
			sfx(1)
		elseif tile.walkable or d_x == 0 and d_y == 0 then
			self.pos.x = new_x
			self.pos.y = new_y
			sfx(1)
		else
			state.updated = false
		end
		
		if tile.item_id then
			self:pick_up(tile.item_id)
		elseif tile.stair then
			sfx(4)
			state.mode = mode_enum.stair
			state.stair_index = 1
		end
		
		if state.turn_counter % 7 == 0 and self.hp < self.max_hp and self.belly > 0 then
			self.hp += 1
		end
		
		if state.turn_counter % 5 == 0 and self.belly > 0 then
			if self.full_belly_timer > 0 then
				self.full_belly_timer -= 1
			else
				self.belly -= 1
			end
			if self.belly == 50 then
				add(state.logline, "You're getting hungry...")
			elseif self.belly == 20 then
				add(state.logline, "You're REALLY hungry! Eat some bread, quick!")
			end
		end
		
		if state.turn_counter % 2 == 0 and self.belly <= 0 then
			self.hp -= 1
			if self.hp > 0 then
				add(state.logline, "You are starving!")
			else
				add(state.logline, "You starved to death :/")
				state.mode = mode_enum.game_end
			end
		end
	end
	
	function player:pick_up(item_id)
		local item = state.items[item_id]
		if #self.inv >= 15 and item.type ~= item_type_enum.gold then
			add(state.logline, "Didn't pick up " .. item.name .. ": Inventory full")
			return
		end
		sfx(4)
		state.items[item_id] = nil
		add(state.logline, "Picked up " .. item.name)
		if item.type == item_type_enum.gold then
			self.gold += item.func
		else
			add(self.inv, item)
			self.inv[#self.inv].id = #self.inv
		end
	end
	
	function player:drop_item(inv_id)
		if self.inv[inv_id] then
			sfx(4)
			deli(self.inv, inv_id)
			state.inv_index = 1
			if self.armor and self.armor.id > inv_id then
				self.armor.id -= 1
			end
			if self.sword and self.sword.id > inv_id then
				self.sword.id -= 1
			end
		else
			sfx(6)
		end
	end
	
	function player:use_item(inv_id)
		if self.inv[inv_id] then
			sfx(4)
			if self.inv[inv_id].type == item_type_enum.armor then
				if self.inv[inv_id].equipped then
					self.inv[inv_id].equipped = false
					self.armor = nil
				elseif self.armor then
					self.inv[self.armor.id].equipped = false
					self.armor = self.inv[inv_id]
					self.armor.id = inv_id
					self.inv[inv_id].equipped = true
				else
					self.armor = self.inv[inv_id]
					self.armor.id = inv_id
					self.inv[inv_id].equipped = true
				end
			elseif self.inv[inv_id].type == item_type_enum.sword then
				if self.inv[inv_id].equipped then
					self.inv[inv_id].equipped = false
					self.sword = nil
				elseif self.sword then
					self.inv[self.sword.id].equipped = false
					self.sword = self.inv[inv_id]
					self.sword.id = inv_id
					self.inv[inv_id].equipped = true
				else
					self.sword = self.inv[inv_id]
					self.sword.id = inv_id
					self.inv[inv_id].equipped = true
				end
			elseif self.inv[inv_id].type == item_type_enum.scroll then
				state.mode = mode_enum.dir
				deli(self.inv, inv_id)
				state.inv_index = 1
			else
				self.inv[inv_id].func(self)
				deli(self.inv, inv_id)
				state.mode = mode_enum.game
				state.inv_index = 1
			end
		else
			sfx(6)
		end
	end
	
	function player:check_surroundings(d_pos)
		if self.belly <= 0 then
			return true
		end
		for i, v in pairs(state.enemies) do
			if v.alive and self:can_see(v.pos) and self.pos:distance_to(v.pos):magn() < 10 then
				return true
			end
		end
		for i=-1, 1 do
			local tile = state.output_tiles[self.pos.y + i][self.pos.x]
			if tile.item_id or 
				tile.type == tile_type_enum.stair or 
				tile.door_id or 
				tile.enemy_id  then
				return true
			end
			tile = state.output_tiles[self.pos.y][self.pos.x + i]
			if tile.item_id or 
				tile.type == tile_type_enum.stair or 
				tile.door_id or 
				tile.enemy_id then
				return true
			end
		end
		for _, v in pairs(state.doors) do
			if abs(v.pos.x - self.pos.x) + abs(v.pos.y - self.pos.y) <= 1 then
				return true
			end
		end
		if not state.output_tiles[self.pos.y + d_pos.y][self.pos.x + d_pos.x].walkable then
			return true
		end
		return false
	end
	
	function player:attack(enemy_id)
		local enemy = state.enemies[enemy_id]
		local dmg = self.dmg
		if self.sword then
			dmg += self.sword.func
		end
		if enemy.hp > dmg then
			state.enemies[enemy_id].hp -= dmg
			state.enemies[enemy_id].state = enemy_state_enum.hostile
			add(state.logline, "Attacked " .. enemy.name .. " for " .. dmg)
		elseif enemy.hp > 0 and enemy.name == "Lich" then
			state.mode = mode_enum.game_end
		elseif enemy.hp > 0 then
			state.enemies[enemy_id].hp -= dmg
			state.enemies[enemy_id].alive = false
			sfx(12)
			add(state.logline, "Killed " .. enemy.name)
			self.xp += enemy.xp
			if self.xp > self.next_xp then self:level_up() end
		end
	end
	
	function player:level_up()
		sfx(9)
		self.next_xp *= 2.5
		self.level += 1
		self.dmg += 2
		self.hp += 5
		self.max_hp += 5
		add(state.logline, self.name .. " leveled up!")
	end
		
	
	function player:can_see(target)
		local new_pos = self.pos
		repeat
			local close_pos = new_pos
			local min_dist = close_pos:distance_to(target):magn()
			for i=-1, 1 do
				for j=-1, 1 do
					local tile = state.output_tiles[new_pos.y + i][new_pos.x + j]
					local dist_mag = tile.pos:distance_to(target):magn()
					if dist_mag < min_dist then
						close_pos = tile.pos
						min_dist = dist_mag
					end
				end
			end
			new_pos = close_pos
			local tile = state.output_tiles[new_pos.y][new_pos.x]
			if not tile.walkable then
				return false
			end
		until new_pos:distance_to(target):magn() == 0
		return true
	end
	
	item_funcs(player)
	return player
end

function get_player_spawn()
	local room = state.rooms[flr(rnd(#state.rooms))]
	local spawn_x = rnd_int(room.top_left.x + 1, room.bot_right.x - 1)
	local spawn_y = rnd_int(room.top_left.y + 1, room.bot_right.y - 1)
	return create_pos(spawn_x, spawn_y)
end
:: pos.lua
--[[pod_format="raw",created="2024-04-04 13:13:39",modified="2024-04-06 16:41:33",revision=256]]
function create_pos(x, y)
	local pos = {}
	pos.x = x
	pos.y = y
	
	function pos:vector_to(target)
		return create_pos(self.x - target.x, self.y - target.y)
	end
	
	function pos:distance_to(target)
		local vector = self:vector_to(target)
		return create_pos(math.abs(vector.x), math.abs(vector.y))
	end
	
	function pos:magn()
		return math.sqrt(self.x^2 + self.y^2)
	end
	
	return pos
end
:: projectile.lua
--[[pod_format="raw",created="2024-04-08 14:15:00",modified="2024-09-25 19:32:07",revision=1390]]
function fire_projectile(start_pos, dir)
	local x_dir = dir.x
	local y_dir = dir.y
	local pos = create_pos(start_pos.x + x_dir, start_pos.y + y_dir)
	local tile = state.output_tiles[pos.y][pos.x]
	
	repeat
		tile = state.output_tiles[pos.y][pos.x]
		if not tile.walkable and not tile.enemy_id then
			return false
		end
		pos.x += x_dir
		pos.y += y_dir
		
		gen_map(state.output_tiles)
	until tile.enemy_id
	return tile.enemy_id
end
		
		
:: room.lua
--[[pod_format="raw",created="2024-04-04 12:52:15",modified="2025-11-26 10:35:23",revision=3058,xstickers={}]]
function create_room(section_id)
	local section = state.sections[section_id]
	local room = {}
	room.id = section_id
	room.top_left = create_pos(rnd_int(section.top_left.x + 1, section.bot_right.x - 5), 
		rnd_int(section.top_left.y + 1, section.bot_right.y - 5))
	room.bot_right = create_pos(rnd_int(room.top_left.x + 4, section.bot_right.x), 
		rnd_int(room.top_left.y + 4, section.bot_right.y))
		
	function room:is_inside(pos)
		if pos.x >= self.top_left.x - 1 and pos.x <= self.bot_right.x + 1 and
			pos.y >= self.top_left.y - 1 and pos.y <= self.bot_right.y + 1 then
			return true
		end
		return false
	end
	
	function room:draw()
		local visible = self:is_inside(state.player.pos)
		for i=self.top_left.y, self.bot_right.y do
			for j=self.top_left.x, self.bot_right.x do
				local tile = create_tile(j, i, 255, tile_type_enum.floor, true)
				tile.room_id = self.id
				if visible then
					tile.sprite = 1
					tile.seen = true
					state.tiles[i][j].seen = true
				end
				state.output_tiles[i][j] = tile
			end
		end
	end
	return room
end

function get_sections()
	local sections = {}
	local sect_height = 15
	local sect_width = 15
	local map_height = #state.tiles
	local map_width = #state.tiles[1]
	
	for i=0, (map_height / sect_height) - 1 do
		for j=0, (map_width / sect_width) - 1 do
			local index
			if i == 2 then
				index = j + 2
			elseif j == 0 then
				index = i
			elseif i == 1 and j == 2 then
				index = 5
			elseif i == 0 and j == 2 then
				index = 6
			elseif i == 0 and j == 1 then
				index = 7
			else
				index = 8
			end
			sections[index] = {}
			sections[index].top_left = create_pos(j * sect_width, i * sect_width)
			sections[index].bot_right = create_pos(((j + 1) * sect_width) - 1,
				((i + 1) * sect_width) - 1)
		end
	end
	
	return sections
end
	
:: stair.lua
--[[pod_format="raw",created="2024-04-07 00:37:57",modified="2025-11-26 11:00:06",revision=1921,xstickers={}]]
function create_stair()
	local stair = {}
	stair.pos = get_stair_pos()
	
	function stair:draw()
		if self.pos.x == state.player.pos.x and 
			self.pos.y == state.player.pos.y or
			not state.player:can_see(self.pos) or 
			state.output_tiles[self.pos.y][self.pos.x].enemy_id then
			return
		end
		local tile = create_tile(
			self.pos.x, 
			self.pos.y, 
			8, 
			tile_type_enum.stair, 
			true)
		tile.seen = true
		state.tiles[self.pos.y][self.pos.x].seen = true
		tile.stair = true
		state.output_tiles[self.pos.y][self.pos.x] = tile
	end
	
	return stair
end

function next_floor()
	sfx(2)	
	state.floor += 1
	state.logline = {"Welcome to floor " .. state.floor}
	if state.floor % 3 == 0 then
		music(7)
	elseif state.floor % 3 == 2 then
		music(6)
	else
		music(4)
	end
	state.updated = false
	state.draw = true
	state.tiles = gen_tiles()
	state.output_tiles = {}
	state.sections = get_sections()
	state.stair_index = 1
	state.inv_index = 1
	state.rooms = {}
	for i, v in pairs(state.sections) do
		state.rooms[i] = create_room(i)
	end
	state.halls = {}
	gen_halls()
	state.doors = {}
	gen_doors()
	state.player.pos = get_player_spawn()
	
	reset_output()
	for _, v in pairs(state.rooms) do
		v:draw()
	end
	for _, v in pairs(state.halls) do
		v:draw()
	end
	for _, v in pairs(state.doors) do
		v:draw()
	end
	gen_enemies()
	state.player:draw()
	for _, v in pairs(state.enemies) do
		if state.player:can_see(v.pos) then
			v:draw()
		end
	end
	gen_items()
	for _, v in pairs(state.items) do
		if state.player:can_see(v.pos) then
			v:draw()
		end
	end
	if state.floor != 10 then
		state.stair = create_stair()
		state.stair:draw()
	else
		state.stair = nil
	end
	
	gen_map(state.output_tiles)
end

		
function get_stair_pos()
	local room_ind = flr(rnd(#state.rooms))
	local room = state.rooms[room_ind]
	local spawn_x, spawn_y, tile
	repeat
		spawn_x = rnd_int(room.top_left.x + 1, room.bot_right.x - 1)
		spawn_y = rnd_int(room.top_left.y + 1, room.bot_right.y - 1)
		tile = state.output_tiles[spawn_y][spawn_x]
	until tile.walkable and not tile.item_id and not tile.enemy_id
	return create_pos(spawn_x, spawn_y)
end	
:: state.lua
--[[pod_format="raw",created="2024-04-03 17:34:57",modified="2024-04-08 23:30:53",revision=1383]]
mode_enum = {
	game_start = 1,
	game = 2,
	inv = 3,
	stair = 4,
	dir = 5,
	game_end = 6
}
:: tiles.lua
--[[pod_format="raw",created="2024-04-03 17:39:00",modified="2025-03-12 14:23:45",revision=4071]]
function create_tile(x, y, sprite, type, walkable)
	local tile = {}
	tile.pos = create_pos(x, y)
	tile.sprite = sprite
	tile.type = type
	tile.seen = false
	tile.item_id = nil
	tile.door_id = nil
	tile.enemy_id = nil
	tile.room_id = nil
	tile.hall_id = nil
	tile.walkable = walkable
	return tile
end

tile_type_enum = {
	player = 0,
	door = 1,
	floor = 2,
	wall = 3,
	item = 4,
	enemy = 5,
	stair = 6
}

function gen_tiles()
	local height = 45
	local width = 45
	local tiles = {}
	for i=0, height do
		tiles[i] = {}
		for j=0, width do
			tiles[i][j] = create_tile(j, i, 2, tile_type_enum.floor, false)
		end
	end
	return tiles
end

function gen_map(tiles)
	for i=0, #tiles do
		for j=0, #tiles[i] do
			mset(j + 15, i + 15, tiles[i][j].sprite+spr_offset)
		end
	end
end

function reset_output()
	for i=0, #state.tiles do
		state.output_tiles[i] = {}
		for j=0, #state.tiles[i] do
			state.output_tiles[i][j] = state.tiles[i][j]
		end
	end
end
:: util.lua
--[[pod_format="raw",created="2024-04-04 23:06:52",modified="2024-09-25 19:35:19",revision=344]]
function rnd_int(start, limit)
	return flr(rnd(limit - start)) + start
end
