--[[pod_format="raw",created="2025-09-03 11:20:06",modified="2025-11-19 14:56:14",revision=56,xstickers={}]]
--[[
Block Gal
(c)2025 Filip Jamroga
--]]

function move()
	if holds_box then
		moveWithBox()
	else
		pos = findPlayer()
		x = pos[1]
		y = pos[2]
		found = pos[3]
		if found then
			if level[y][x+facing] == 0 then
				level[y][x+facing] = 4
				level[y][x]        = 0
			elseif level[y][x+facing] == 3 then
				win = true
			end
		end
	end
end

function moveWithBox()
	pos = findPlayer()
	x = pos[1]
	y = pos[2]
	found = pos[3]
	if found then
		if 
			level[y][x+facing] == 0 
			and
			level[y-1][x+facing] == 0 
		then
			level[y  ][x+facing] = 4
			level[y  ][x       ] = 0
			level[y-1][x+facing] = 2
			level[y-1][x       ] = 0
			boxGravity(x+facing, y-1)
		end
	end
end

function pickupBox()
	if holds_box then
		dropBox()
	else
		pos = findPlayer()
		x = pos[1]
		y = pos[2]
		found = pos[3]
		if found then
			if 
				level[y][x+facing] == 2 
				and 
				level[y-1][x] == 0
				and
				not (level[y-1][x+facing] == 2)
			then
				level[y-1][x] = 2
				level[y][x+facing] = 0
				holds_box = true
			end
		end
	end
end

function dropBox()
	pos = findPlayer()
	x = pos[1]
	y = pos[2]
	found = pos[3]
	if found then
		if 
			level[y][x+facing] == 0 
		then
			level[y-1][x] = 0
			level[y][x+facing] = 2
			holds_box = false
			boxGravity(x+facing, y)
		elseif 
			level[y-1][x+facing] == 0 
		then
			level[y-1][x] = 0
			level[y-1][x+facing] = 2
			holds_box = false
		end
	end
end

function climbUp()
	if holds_box then
		climbUpWithBox()
	else
		pos = findPlayer()
		x = pos[1]
		y = pos[2]
		found = pos[3]
		if found then
			if 
				level[y-1][x+facing] == 0 
				and 
				(
					level[y][x+facing] == 1
					or
					level[y][x+facing] == 2
				) 
			then
				level[y-1][x+facing] = 4
				level[y  ][x       ] = 0
			elseif level[y-1][x+facing] == 3 then
				win = true
			end
		end
	end
end

function climbUpWithBox()
	pos = findPlayer()
	x = pos[1]
	y = pos[2]
	found = pos[3]
	if found then
		if 
			level[y-1][x+facing] == 0 
			and
			level[y-2][x+facing] == 0 
			and
			(
				level[y][x+facing] == 1
				or
				level[y][x+facing] == 2
			) 
		then
			level[y-1][x+facing] = 4
			level[y  ][x       ] = 0
			level[y-2][x+facing] = 2
			level[y-1][x       ] = 0
		end
	end
end

function playerGravity()
	pos = findPlayer()
	x = pos[1]
	y = pos[2]
	found = pos[3]
	if found then
		if level[y+1][x] == 0 then
			level[y+1][x] = 4
			level[y][x]   = 0
			if holds_box then
				boxGravity(x, y-1)
			end
		elseif level[y+1][x] == 3 then
			win = true
		end
	end
end

function boxGravity(x,y)
	while level[y+1][x] == 0 do
		level[y+1][x] = 2
		level[y][x]   = 0
		y += 1
	end
end

function findPlayer()
	for y, row in pairs(level) do
		for x, cell in pairs(row) do
			if cell == 4 then
				return {x, y, true}
			end
		end
	end
	return {0, 0, false}
end

function calcOffset()
	level_h = ((#level)*16)
	level_w = ((#level[1])*16)
	x_offset = max((480-level_w)/2, 0)
	y_offset = max((270-level_h)/2, 0)
end
:: main.lua
--[[pod_format="raw",created="2025-09-03 11:19:49",modified="2025-12-11 17:10:23",revision=95,xstickers={}]]
--[[
Block Gal
(c)2025 Filip Jamroga
--]]

include("levels.lua")
include("lib.lua")
include("selector.lua")

function _init()
	MODE = "SELECTOR"
	message = ""
	SIZE = 16
	DELAY_MAX = 10
	SPR_OFFSET = 8
	spr_selector = 0
	BACKGROUND = 28
	Selector:configure()
	level_1()
end

function _update()
	if MODE == "GAME" then
		if delay == 0 then
			if btn(0) then
				facing = -1
				move()
				delay = DELAY_MAX
			elseif btn(1) then
				facing = 1
				move()
				delay = DELAY_MAX
			elseif btn(2) then
				climbUp()
				delay = DELAY_MAX
			elseif btn(3) then
				pickupBox()
				delay = DELAY_MAX
			elseif btn(4) then
				spr_selector = (spr_selector+1)%2
				if spr_selector==0 then
					BACKGROUND = 28
				elseif spr_selector==1 then
					BACKGROUND = 7
				end
				delay = DELAY_MAX
			end
		else
			delay -= 1
		end
		playerGravity()
	elseif MODE == "SELECTOR" then
		Selector:update()
	elseif MODE == "PASSWORD" then
	end
end

function _draw()
	if MODE == "GAME" then
		if win then
			message = message.."YOU WON! "
			print(message)
			level_next()
		else
			cls(BACKGROUND)
			scroll_y = 0
			if findPlayer()[2]>9 and scroll_h then
				scroll_y = -32
			end
			for y, row in pairs(level) do
				for x, cell in pairs(row) do
					offset = spr_selector*SPR_OFFSET
					if cell == 4 then
						offset+=max(0,facing)
					end
					spr(cell+offset, (x-1)*SIZE+x_offset, (y-1)*SIZE+scroll_y+y_offset)
				end
			end
		end
	elseif MODE == "SELECTOR" then
		Selector:draw()
	elseif MODE == "PASSWORD" then
	end
end
:: selector.lua
--[[pod_format="raw",created="2025-12-11 12:39:02",modified="2025-12-12 09:05:43",revision=89,xstickers={}]]
Selector = {
}

function Selector:configure()
	self.lock = {
		[1] = true,
		[2] = false,
		[3] = false,
		[4] = false,
		[5] = false,
		[6] = false,
		[7] = false,
		[8] = false,
		[9] = false,
		[10] = false,
		[11] = false,
	}
	if fstat("/appdata/BlockGal")==nil then
		mkdir("/appdata/BlockGal")
	end
	if fstat("/appdata/BlockGal/lock.pod")!=nil then
		self.lock = fetch("/appdata/BlockGal/lock.pod")
	end
end

function Selector:update()
	if btnp(4) then
		spr_selector = (spr_selector+1)%2
		if spr_selector==0 then
			BACKGROUND = 28
		elseif spr_selector==1 then
			BACKGROUND = 7
		end
	end
	
	mx,my,mb=mouse()
	if mb>0 and mx>2 and mx<185 and my>21 and my<37 then
		mx = flr((mx-2)/18)
		if self.lock[mx+1] then
			MODE = "GAME"
			LEVELS[mx+1]()
		end
	end
end

function Selector:draw()
	cls(BACKGROUND)
	spr(64 + spr_selector*8, 2, 2)
	for i=1,11 do
		if self.lock[i] then
			s = 7 + spr_selector*8
		else
			s = 6 + spr_selector*8
		end
		spr(s, 2+(i-1)*18, 4+17)
		if i>9 then
			print(i, 2+(i-1)*18+3, 4+5+17, 0)
		else
			print(i, 2+(i-1)*18+6, 4+5+17, 0)
		end
	end
end

function Selector:unlock(level)
	self.lock[level] = true
	store("/appdata/BlockGal/lock.pod", self.lock)
end
