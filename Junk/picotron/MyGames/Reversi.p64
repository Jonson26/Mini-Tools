:: ai.lua
--[[pod_format="raw",created="2025-10-23 14:55:30",modified="2025-10-29 15:56:28",revision=13,xstickers={}]]
function dumbAIMove()
	possibleMoves = {}
	i=0
	for x=1,8,1 do
		for y=1,8,1 do
			if isSuitable(x, y) then
				possibleMoves[i] = {x, y}
				i+=1
			end
		end
	end
	if i>0 then 
		m = rndInt(0, i)
		dx = possibleMoves[m][1]
		dy = possibleMoves[m][2]
		makeMove(dx, dy)
	end
end

function maximizeScoreAIMove()
	possibleMoves = {}
	i=0
	for x=1,8,1 do
		for y=1,8,1 do
			if isSuitable(x, y) then
				possibleMoves[i] = {x, y, flips}
				i+=1
			end
		end
	end
	if i>0 then 
		maxS = 0
		maxI = 0
		for m=0,i-1,1 do
			if possibleMoves[m][3]>maxS then
				maxS = possibleMoves[m][3]
				maxI = m
			end
		end
		m = maxI
		dx = possibleMoves[m][1]
		dy = possibleMoves[m][2]
		makeMove(dx, dy)
	end
end

function maximizeScoreWithEdgePriorityAIMove()
	possibleMoves = {}
	i=0
	for x=1,8,1 do
		for y=1,8,1 do
			if isSuitable(x, y) then
				possibleMoves[i] = {x, y, flips}
				if x==1 or x==8 then possibleMoves[i][3]+=1 end
				if y==1 or y==8 then possibleMoves[i][3]+=1 end
				i+=1
			end
		end
	end
	if i>0 then 
		maxS = 0
		maxI = 0
		for m=0,i-1,1 do
			if possibleMoves[m][3]>maxS then
				maxS = possibleMoves[m][3]
				maxI = m
			end
		end
		m = maxI
		dx = possibleMoves[m][1]
		dy = possibleMoves[m][2]
		makeMove(dx, dy)
	end
end
